{
  "name": "esp-wifi-config-react-native",
  "version": "1.0.0",
  "description": "React Native library for ESP-IDF Network Provisioning (BLE) on devices running esp_wifi_config 0.2.0+",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WiFiConfig/esp-wifi-config-react-native.git"
  },
  "homepage": "https://github.com/WiFiConfig/esp-wifi-config-react-native#readme",
  "bugs": {
    "url": "https://github.com/WiFiConfig/esp-wifi-config-react-native/issues"
  },
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/index.d.ts",
  "react-native": "src/index.ts",
  "source": "src/index.ts",
  "exports": {
    ".": {
      "react-native": "./src/index.ts",
      "import": "./lib/module/index.js",
      "require": "./lib/commonjs/index.js",
      "types": "./lib/typescript/index.d.ts"
    },
    "./navigation": {
      "react-native": "./src/navigation/index.ts",
      "import": "./lib/module/navigation/index.js",
      "require": "./lib/commonjs/navigation/index.js",
      "types": "./lib/typescript/navigation/index.d.ts"
    }
  },
  "files": [
    "src",
    "lib",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__"
  ],
  "scripts": {
    "build": "bob build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "test": "jest",
    "prepare": "bob build"
  },
  "keywords": [
    "react-native",
    "ble",
    "bluetooth",
    "wifi",
    "provisioning",
    "esp32",
    "esp_wifi_config",
    "iot"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@orbital-systems/react-native-esp-idf-provisioning": ">=0.5.0",
    "@react-navigation/native": ">=7.0.0",
    "@react-navigation/native-stack": ">=7.0.0",
    "react": ">=18.0.0",
    "react-native": ">=0.72.0",
    "react-native-safe-area-context": ">=4.0.0",
    "react-native-screens": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "@react-navigation/native": {
      "optional": true
    },
    "@react-navigation/native-stack": {
      "optional": true
    },
    "react-native-screens": {
      "optional": true
    },
    "react-native-safe-area-context": {
      "optional": true
    }
  },
  "dependencies": {
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@orbital-systems/react-native-esp-idf-provisioning": "^0.5.5",
    "@react-navigation/native": "^7.0.0",
    "@react-navigation/native-stack": "^7.0.0",
    "@testing-library/react-native": "^12.0.0",
    "@types/jest": "^29.5.0",
    "@types/react": "^18.2.0",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jest": "^29.7.0",
    "react": "^18.2.0",
    "react-native": "^0.76.0",
    "react-native-builder-bob": "^0.35.0",
    "react-native-safe-area-context": "^4.14.0",
    "react-native-screens": "^4.4.0",
    "ts-jest": "^29.2.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.69.0"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "modulePathIgnorePatterns": [
      "<rootDir>/lib/",
      "<rootDir>/example_app/"
    ],
    "moduleNameMapper": {
      "^@orbital-systems/react-native-esp-idf-provisioning$": "<rootDir>/src/__mocks__/esp-idf-provisioning.ts",
      "^react-native$": "<rootDir>/src/__mocks__/react-native.ts"
    }
  }
}
